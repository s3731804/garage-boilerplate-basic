{
  "name": "garage-boilerplate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/sync-env.js && pnpm --filter frontend dev",
    "env:sync": "node scripts/sync-env.js",
    "build": "pnpm --filter frontend build && pnpm --filter backend build && pnpm --filter @team34/extension build && pnpm --filter @team34/scanner-sandbox build",
    "test": "pnpm --filter backend test",
    "test:component": "pnpm --filter frontend test",
    "test:extension": "pnpm --filter @team34/extension test",
    "test:scanner": "pnpm --filter @team34/scanner-sandbox test",
    "test:all": "pnpm run test && pnpm run test:component && pnpm run test:extension && pnpm run test:scanner",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "bootstrap": "node scripts/bootstrap.js",
    "validate": "node scripts/validate-placeholders.js",
    "hooks": "lefthook install",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^1.13.6",
    "next": "16.3.3"
  }
}
